    classDef stage2 fill:#5b9bd5,stroke:#1f4e79,color:#000
    classDef corefs fill:#ffcccc,stroke:#b30000,color:#000
    classDef planned fill:#fff2cc,stroke:#7f6000,stroke-dasharray:5 3,color:#000
    classDef aliased fill:#b4a7d6,stroke:#4c3a75,stroke-dasharray:5 3,color:#000
    classDef video fill:#bfbfbf,stroke:#3f3f3f,color:#000
