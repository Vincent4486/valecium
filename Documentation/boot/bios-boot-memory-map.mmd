%% BIOS / i686 boot memory map - hand-written source of truth.
%% Render with:  mmdc -i bios-boot-memory-map.mmd -o bios-boot-memory-map.svg -b white
%% Addresses come from the i686 debug build: core.bin 0x6A44, corefs_fat.bin
%% 0x2ACC with 0x46A0 of .bss, libTheBootloader.so 0x49BC4, kernel image
%% 0x100000 - 0x1C6047 (two PT_LOAD segments, entry 0x10000C).
%% Every label is wrapped in a div of the same fixed width so that all boxes
%% come out the same size; without it mermaid sizes each box to its own text.
%% wrappingWidth must stay equal to that div width: mermaid only switches a
%% label to wrapped text when the measured width matches wrappingWidth, and
%% otherwise keeps it on one line and clips it at the box edge.
%%{init: {"theme":"base","themeVariables":{"fontFamily":"Helvetica","fontSize":"16px","lineColor":"#666"},"flowchart":{"useMaxWidth":false,"nodeSpacing":2,"rankSpacing":1,"padding":4,"wrappingWidth":520,"diagramPadding":8}}}%%
flowchart TB
    IVT["<div style='width:520px;text-align:left'>0x00000 - 0x003FF | 1 KiB<br/>IVT - real-mode interrupt vector table</div>"]:::firmware
    BDA["<div style='width:520px;text-align:left'>0x00400 - 0x004FF | 256 B<br/>BDA - BIOS data area</div>"]:::firmware
    THUNK["<div style='width:520px;text-align:left'>0x00500 - 0x006FF | 512 B<br/>BIOS scratch, and the disk.S real-mode window: thunk copy at 0x500, INT 13h parameter block at 0x600</div>"]:::scratch
    FREE1["<div style='width:520px;text-align:left'>0x00700 - 0x04FFF | 18 KiB<br/>free conventional memory</div>"]:::free
    STASH["<div style='width:520px;text-align:left'>0x05000 - 0x0520D | 526 B<br/>boot parameter stash, BIOS drive list, VBE scratch</div>"]:::firmware
    FREE2["<div style='width:520px;text-align:left'>0x0520E - 0x05FFF | 3.5 KiB<br/>free</div>"]:::free
    MBI["<div style='width:520px;text-align:left'>0x06000 - 0x07BFF | 7 KiB max<br/>Multiboot2 boot information from detect.S - about 0x100 B in practice; the disk.S Disk Address Packet lives at 0x7000</div>"]:::firmware
    STAGE1["<div style='width:520px;text-align:left'>0x07C00 - 0x07DFF | 512 B<br/>stage1 boot.bin - MBR boot sector; the disk.S real-mode stack top is also 0x7C00 and grows down, away from it</div>"]:::stage1
    STAGE2["<div style='width:520px;text-align:left'>0x07E00 - 0x1E6AB | 0x168AC<br/>stage2 core.bin - image 0x7E00 - 0xE843 (.entry, .early_data, .text, dead .eh_frame)<br/>plus .bss 0xE860 - 0x1E6AB (loader statics, stage2 statics, uart/vbe statics, vga.c s_Shadow 64000 B, palette, cursors)</div>"]:::stage2
    FREE3["<div style='width:520px;text-align:left'>0x1E6AC - 0x7EFFF | 386 KiB<br/>free - stage2 .bss ends here; s_Shadow no longer reaches 0x90000, which is what cleared the corefs collision</div>"]:::free
    TRAMP["<div style='width:520px;text-align:left'>0x7F000 - 0x7FFFF | 4 KiB<br/>kernel-load trampoline, planned - position-dependent blob, copied here and executed because stage3 cannot survive the copy</div>"]:::planned
    BOUNCE["<div style='width:520px;text-align:left'>0x80000 - 0x8FFFF | 64 KiB<br/>kernel-load bounce buffer, planned - INT 13h can only write below 1 MiB, chunks never cross a 64 KiB boundary</div>"]:::planned
    COREFS["<div style='width:520px;text-align:left'>0x90000 - 0x9717F | 0x717F<br/>corefs module - filesystem driver and disk I/O, appended to the boot image by the image builder<br/>exports and text 0x90000 - 0x92ADF, module .bss to 0x9717F (fat; ext2 and iso9660 are smaller). Stays resident, so the kernel loader can call DISK_ReadLBA</div>"]:::corefs
    HEADROOM["<div style='width:520px;text-align:left'>0x97180 - 0x9FBFF | 34.6 KiB<br/>free stack headroom - stage2 sets ESP to 0x9FC00 and grows toward lower addresses, so it hits the top of the corefs module first</div>"]:::free
    EBDA["<div style='width:520px;text-align:left'>0x9FC00 - 0x9FFFF | 1 KiB<br/>above the stack top - conventionally the BIOS EBDA</div>"]:::free
    VGAFB["<div style='width:520px;text-align:left'>0x0A0000 - 0x0AFFFF | 64 KiB<br/>VGA graphics framebuffer - mode 0x13</div>"]:::video
    MDA["<div style='width:520px;text-align:left'>0x0B0000 - 0x0B7FFF | 32 KiB<br/>MDA text framebuffer</div>"]:::video
    TEXTFB["<div style='width:520px;text-align:left'>0x0B8000 - 0x0BFFFF | 32 KiB<br/>colour text framebuffer</div>"]:::video
    ROM["<div style='width:520px;text-align:left'>0x0C0000 - 0x0FFFFF | 256 KiB<br/>option ROMs and system BIOS</div>"]:::rom
    SAME["<div style='width:520px;text-align:left'>0x100000 - 0x1C6047 | 792 KiB<br/>two users of the same bytes: stage3 window and kernel image<br/>stage3: libTheBootloader.so (0x49BC4) is read here and DL-loaded in place<br/>kernel: linked at 0x100000, two PT_LOAD segments 0x100000 + 0x25D58 and 0x125D60 + 0xA02E8, entry 0x10000C<br/>the trampoline reads the kernel through INT 13h in 64 KiB chunks into 0x80000, copies each chunk up, zeroes .bss, then jumps with Multiboot2 magic 0x36D76289 in EAX and the info pointer 0x6000 in EBX</div>"]:::aliased
    FREERAM["<div style='width:520px;text-align:left'>0x1C6048 - 0x1FFFFF | 232 KiB<br/>free RAM above the kernel image</div>"]:::free

    IVT ~~~ BDA ~~~ THUNK ~~~ FREE1 ~~~ STASH ~~~ FREE2 ~~~ MBI ~~~ STAGE1 ~~~ STAGE2 ~~~ FREE3 ~~~ TRAMP ~~~ BOUNCE ~~~ COREFS ~~~ HEADROOM ~~~ EBDA ~~~ VGAFB ~~~ MDA ~~~ TEXTFB ~~~ ROM ~~~ SAME ~~~ FREERAM

